# Copy to .env.local and fill in. .env.local stays out of git. All keys are server-side only (never prefix with NEXT_PUBLIC_), except the NEXT_PUBLIC_PRIVY_APP_ID below.

# Atlas Oracle pull-mode API key: signed bStocks prices the vault uses.
ATLAS_API_KEY=

# CoinMarketCap Pro API key: cross-checks Atlas prices and gives market data.
CMC_API_KEY=

# Cournot Intelligence Oracle: the vault's risk check. Optional. Without it the server uses Cournot's free calls
# (three per IP, ever); with a prepaid key each risk check uses one prepaid call.
COURNOT_API_KEY=

# Privy app ID (public, from dashboard.privy.io): email/Google sign-in and embedded wallets. Empty = browser wallet only.
NEXT_PUBLIC_PRIVY_APP_ID=
